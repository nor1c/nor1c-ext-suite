{
  "manifest_version": 3,
  "name": "Nor1c Suite",
  "version": "1.0.0",
  "description": "Multi-function browser extension: force right-click, copy link text, image viewer, image/GIF blocker, video controls, video download.",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "downloads",
    "activeTab",
    "clipboardWrite",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nor1c Suite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/right-click.js",
        "content/context-listener.js",
        "content/image-blocker.js",
        "content/gif-blocker.js",
        "content/video-controls.js",
        "content/ad-link-bypass.js",
        "content/element-hider.js"
      ],
      "css": ["content/image-viewer.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "all_frames": true,
      "exclude_matches": ["*://www.youtube.com/*", "*://*.globo.com/*"],
      "js": [
        "content/video-play-reset.js",
        "content/video-downloader-inject.js"
      ],
      "matches": ["<all_urls>"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/image-viewer.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*", "lib/*", "assets/*", "watcher.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
