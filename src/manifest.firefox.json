{
  "manifest_version": 3,
  "name": "Nor1c Suite",
  "version": "1.0.0",
  "description": "Multi-function browser extension: copy link text, image viewer, image/GIF blocker, video controls, video download.",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "downloads",
    "activeTab",
    "clipboardWrite",
    "tabs",
    "webRequest",
    "webNavigation"
  ],
  "commands": {
    "switch-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Open quick tab switcher"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nor1c-suite@noric.dev",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nor1c Suite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content/tiktok-background-playback.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "content/youtube-control-panel.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/utils.js",
        "content/context-listener.js",
        "content/url-cleaner.js",
        "content/image-blocker.js",
        "content/gif-blocker.js",
        "content/video-controls.js",
        "content/volume-control.js",
        "content/ad-link-bypass.js",
        "content/element-hider.js",
        "content/save-to-png.js",
        "content/smooth-scroll.js",
        "content/class-blocker.js",
        "content/disable-animations.js",
        "content/cookie-consent.js"
      ],
      "css": [
        "content/image-viewer.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content/youtube-panel-overlay.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "all_frames": true,
      "exclude_matches": [
        "*://www.youtube.com/*",
        "*://*.globo.com/*"
      ],
      "js": [
        "content/video-downloader-loader.js",
        "content/video-playing-tracker.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/image-viewer.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/tab-switcher-overlay.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "lib/*",
        "assets/*",
        "watcher.js",
        "tab-switcher.html",
        "youtube-control-panel.html",
        "youtube-control-panel.css",
        "youtube-control-panel.js",
        "website-blocker-panel.html",
        "website-blocker-panel.css",
        "website-blocker-panel.js",
        "blocked.html",
        "blocked.css",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
